---
import '../styles/tokens.css';
import '../styles/site.css';
import BaseLayout from '../../../../shared/components/BaseLayout.astro';
import Img from '../../../../shared/components/Img.astro';
import content from '../content/site.json';
import links from '../content/links.json';
import hero from '../assets/hero.jpg';
import intro1 from '../assets/intro-1.jpg';
import intro2 from '../assets/intro-2.jpg';
import intro3 from '../assets/intro-3.jpg';
import feature1 from '../assets/feature-1.jpg';
import feature2 from '../assets/feature-2.jpg';
import shop1 from '../assets/shop-1.jpg';
import shop2 from '../assets/shop-2.jpg';
import shop3 from '../assets/shop-3.jpg';
import shop4 from '../assets/shop-4.jpg';
import shop5 from '../assets/shop-5.jpg';
import shop6 from '../assets/shop-6.jpg';
import event1 from '../assets/event-1.jpg';
import event2 from '../assets/event-2.jpg';
import ctaImg from '../assets/cta.jpg';

// Each section is looked up by its id in the content file.
const section = (id: string): any => content.sections.find((s) => s.id === id);
const header = section('header');
const heroS = section('hero');
const intro = section('intro');
const f1 = section('feature-1');
const f2 = section('feature-2');
const more = section('more-than');
const shop = section('shop');
const agenda = section('agenda');
const testimonials = section('testimonials');
const partners = section('partners');
const cta = section('cta');
const footer = section('footer');

// Sub-pages are not built: links resolve to on-page anchors.
const map = links as Record<string, string>;
const href = (key: string): string => map[key] ?? '#';

type MenuItem = string | { label: string; children: string[] };
const menu = header.menu as MenuItem[];
const shopImages = [shop1, shop2, shop3, shop4, shop5, shop6];
const circleColors = ['green', 'grey', 'yellow', 'accent', 'cyan', 'purple'];
const eventImages = [event1, event2, intro3];
const stars = [1, 2, 3, 4, 5];
---

<BaseLayout title={content.seo.title} description={content.seo.description}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking web fonts (display=swap); fallback stack renders first. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" /></noscript>
  </Fragment>

  <header slot="header" class="hdr">
    <div class="hdr__inner">
      <a class="hdr__logo" href="/">{header.logoText}</a>
      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="nav">
        <span class="visually-hidden">Abrir menu</span>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
      <nav id="nav" class="hdr__nav" aria-label="Principal">
        <ul class="hdr__list">
          {menu.map((item) =>
            typeof item === 'string' ? (
              <li><a href={href(item)}>{item}</a></li>
            ) : (
              <li class="dd">
                <button class="dd__btn" type="button" aria-expanded="false">
                  {item.label}
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4l4 4 4-4"></path></svg>
                </button>
                <ul class="dd__menu">
                  {item.children.map((c) => <li><a href={href(c)}>{c}</a></li>)}
                </ul>
              </li>
            )
          )}
        </ul>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="hero__text">
      <h1 class="hero__title">{heroS.heading}</h1>
      <p>[TODO]</p>
      <div class="btns">
        <a class="btn btn--accent" href={href(heroS.ctas[0].href)}>{heroS.ctas[0].label}</a>
        <a class="btn btn--outline" href={href(heroS.ctas[1].href)}>{heroS.ctas[1].label}</a>
      </div>
    </div>
    <Img class="hero__img" src={hero} alt={heroS.image.alt} priority sizes="(min-width: 810px) 50vw, 100vw" />
  </section>

  <section id="sobre" class="intro container-x">
    <div class="intro__text">
      <h2 class="h2">{intro.heading}</h2>
      <p class="muted">[TODO]</p>
      <a class="btn btn--dark" href={href(intro.link.href)}>{intro.link.label}</a>
    </div>
    <div class="intro__media">
      <svg class="badge" viewBox="0 0 160 160" aria-hidden="true">
        <defs><path id="badge-path" d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1-124 0"></path></defs>
        <text><textPath href="#badge-path">{`${header.logoText} ★ ${header.logoText} ★ `}</textPath></text>
        <circle cx="80" cy="80" r="26" fill="none" stroke="currentColor" stroke-width="2"></circle>
      </svg>
      <Img class="intro__a" src={intro1} alt="" sizes="(min-width: 810px) 20vw, 50vw" />
      <Img class="intro__b" src={intro2} alt="" sizes="(min-width: 810px) 20vw, 50vw" />
      <Img class="intro__c" src={intro3} alt="" sizes="(min-width: 810px) 30vw, 100vw" />
    </div>
  </section>

  <div class="dark">
    <section id="espaco" class="center container-x">
      <p class="eyebrow">{content.businessName}</p>
      <h2 class="h2">{f1.heading}</h2>
      <p>{f1.text} <a class="link" href={href(f1.link.href)}>{f1.link.label}</a></p>
      <Img class="center__img" src={feature1} alt={f1.image.alt} sizes="(min-width: 810px) 60vw, 100vw" />
    </section>

    <section class="feature container-x">
      <div class="feature__text">
        <h2 class="h2">{f2.heading}</h2>
        <p>{f2.text}</p>
        <div class="btns">
          <a class="btn btn--accent" href={href(f2.link.href)}>{f2.link.label}</a>
        </div>
      </div>
      <Img class="feature__img" src={feature2} alt={f2.image.alt} sizes="(min-width: 810px) 40vw, 100vw" />
    </section>

    <section id="cardapio" class="feature feature--rev container-x">
      <Img class="feature__img" src={intro2} alt="" sizes="(min-width: 810px) 40vw, 100vw" />
      <div class="feature__text">
        <h2 class="h2">{more.heading}</h2>
        <p>{more.text}</p>
        <div class="btns">
          <a class="btn btn--accent" href={href(more.cta.href)}>{more.cta.label}</a>
        </div>
      </div>
    </section>
  </div>

  <section id="loja" class="section container-x" aria-labelledby="shop-title" data-carousel>
    <div class="center">
      <p class="eyebrow">[TODO]</p>
      <h2 id="shop-title" class="h2">{shop.heading}</h2>
      <p>[TODO]</p>
    </div>
    <div class="carousel">
      <button class="round" type="button" data-prev><span class="visually-hidden">Anterior</span><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 9H3m5-5L3 9l5 5"></path></svg></button>
      <ul class="carousel__track" data-track>
        {shop.items.map((p: any, i: number) => (
          <li class="product">
            <div class:list={['product__circle', `product__circle--${circleColors[i]}`]}>
              <Img class="product__img" src={shopImages[i]} alt={p.image.alt} sizes="240px" />
              <span class="product__price">{p.price}</span>
            </div>
            <h3 class="product__name">{p.name}</h3>
            <a class="product__more" href={href(shop.cta.href)}>Mais informações</a>
          </li>
        ))}
      </ul>
      <button class="round" type="button" data-next><span class="visually-hidden">Próximo</span><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h12m-5-5l5 5-5 5"></path></svg></button>
    </div>
    <div class="center">
      <a class="btn btn--dark" href={href(shop.cta.href)}>{shop.cta.label}</a>
    </div>
  </section>

  <section id="agenda" class="section container-x" aria-labelledby="agenda-title">
    <div class="center">
      <p class="eyebrow">{header.menu.find((m: MenuItem) => m === 'Agenda')}</p>
      <h2 id="agenda-title" class="h2">{agenda.heading}</h2>
      <p>[TODO]</p>
    </div>
    <ul class="events">
      {agenda.items.map((e: { title: string; link: string }, i: number) => (
        <li class="event">
          <Img class="event__img" src={eventImages[i]} alt="" sizes="(min-width: 810px) 33vw, 100vw" />
          <div class="event__body">
            <div class="event__row">
              <h3 class="event__title">{e.title}</h3>
              <p>[TODO]</p>
            </div>
            <a class="btn btn--dark" href={href('Agenda')}>{e.link}</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="reviews-title">
    <div class="container-x">
      <p class="eyebrow">[TODO]</p>
      <h2 id="reviews-title" class="h2 reviews__title">[TODO]</h2>
      <ul class="reviews__logos">
        {testimonials.logos.map((l: string) => <li>{l}</li>)}
      </ul>
    </div>
    <ul class="reviews" tabindex="0" aria-label="Depoimentos">
      {testimonials.items.map((t: { quote: string; author: string }) => (
        <li class="review">
          <p class="review__stars" role="img" aria-label="5 de 5 estrelas">
            {stars.map(() => <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4L1.5 9.6 9 8.9z" fill="currentColor"></path></svg>)}
          </p>
          <blockquote class="review__quote"><p>{t.quote}</p></blockquote>
          <p class="review__author"><span class="review__avatar" aria-hidden="true">{t.author.charAt(0)}</span>{t.author}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section center container-x" aria-labelledby="partners-title">
    <p class="eyebrow">[TODO]</p>
    <h2 id="partners-title" class="h2">{partners.heading}</h2>
    <p>[TODO]</p>
  </section>
  <div class="marquee" aria-label="Parceiros">
    <ul class="marquee__track">
      {[...partners.logos, ...partners.logos].map((l: string, i: number) => <li aria-hidden={i >= partners.logos.length ? 'true' : undefined}>{l}</li>)}
    </ul>
  </div>

  <ul class="usp" aria-label="Diferenciais">
    {[1, 2, 3].map(() => <li><span aria-hidden="true">★</span> [TODO] <span aria-hidden="true">★</span></li>)}
  </ul>

  <section id="contato" class="cta">
    <div class="cta__text container-x">
      <h2 class="h2">{cta.heading}</h2>
      <p>[TODO]</p>
      <div class="btns">
        <a class="btn btn--accent" href={href(cta.cta.href)}>{cta.cta.label}</a>
      </div>
    </div>
    <Img class="cta__img" src={ctaImg} alt={cta.image.alt} sizes="(min-width: 810px) 30vw, 60vw" />
  </section>

  <footer slot="footer" class="ftr">
    <div class="ftr__grid container-x">
      <div class="ftr__brand">
        <a class="hdr__logo" href="/">{header.logoText}</a>
        <p class="ftr__phone">{footer.phone}</p>
        <p>[TODO]</p>
        <p class="ftr__mail">[TODO]</p>
        <ul class="ftr__social">
          {footer.socials.map((s: string) => <li>{s}</li>)}
        </ul>
      </div>
      <nav aria-labelledby="ftr-links">
        <h2 id="ftr-links" class="ftr__head">Links úteis</h2>
        <ul class="ftr__list">
          {footer.menu.map((m: string) => <li><a href={href(m)}>{m}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="ftr__head">Horário de funcionamento</h2>
        <p>[TODO]</p>
      </div>
    </div>
    <div class="ftr__legal container-x">
      <p>© {new Date().getFullYear()} {content.businessName}</p>
      {footer.legal.map((l: string) => <span>{l} [TODO]</span>)}
    </div>
  </footer>
</BaseLayout>

<script>
  // Mobile nav toggle and dropdown submenu (click/keyboard), Esc closes.
  const toggle = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const nav = document.getElementById('nav');
  const dropdowns = [...document.querySelectorAll<HTMLButtonElement>('.dd__btn')];
  const closeAll = () => dropdowns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  });
  dropdowns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      closeAll();
      btn.setAttribute('aria-expanded', String(open));
    })
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeAll();
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('is-open');
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.dd')) closeAll();
  });

  // Product carousel: arrows scroll the track by one card.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((el) => {
    const track = el.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
    el.querySelector('[data-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    el.querySelector('[data-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>
